---
// P:stolinkr with one half lit and the other dimmed.
import { FULL_VIEWBOX, PISTOL, INKR } from '../data/marks';
interface Props { lit: 'pistol' | 'inkr' }
const { lit } = Astro.props;
const dim = lit === 'pistol' ? INKR : PISTOL;
const on = lit === 'pistol' ? PISTOL : INKR;
---
<svg class="name-mark" viewBox={FULL_VIEWBOX} role="img" aria-label={`pistolinkr with ${lit} highlighted`}>
  <g class="dim">{dim.map((d) => <path d={d} />)}</g>
  <g class="lit" fill="currentColor">{on.map((d) => <path d={d} />)}</g>
</svg>
